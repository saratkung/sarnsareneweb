# Copy to .env and adjust. Production sets these as real secrets.

# Dev: SQLite (connection_limit=1 avoids lock errors). Prod: postgresql://…
DATABASE_URL="file:./dev.db?connection_limit=1"

# Admin account created by `npm run db:seed`.
ADMIN_EMAIL="admin@sarnsarene.com"
ADMIN_PASSWORD="change-me"

# Random string used to hash session tokens. Rotating it logs everyone out.
AUTH_SECRET="change-me"

# "mock" | "omise" | "twoctwop"
PAYMENT_PROVIDER="mock"

# Public site origin (canonical URLs / sitemap / OG). e.g. https://sarnsarene.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
