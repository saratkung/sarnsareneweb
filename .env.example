# Copy to .env and fill in. Vercel: set these in Project → Settings → Environment Variables.

# --- Database (PostgreSQL) --------------------------------------------------
# Neon / Vercel Postgres give you two strings:
#   DATABASE_URL          = the POOLED connection  (…-pooler.…  or  ?pgbouncer=true)
#   DATABASE_URL_UNPOOLED = the DIRECT connection  (used by `prisma migrate`)
# The Neon / Vercel Storage integration sets both automatically on Vercel.
# For a plain Postgres, point both at the same URL.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- Auth ----------------------------------------------------------------
# Random string used to hash session tokens. Rotating it logs everyone out.
AUTH_SECRET="generate-a-long-random-string"

# The admin account created by `npm run db:seed`.
ADMIN_EMAIL="admin@sarnsarene.com"
ADMIN_PASSWORD="set-a-strong-password"

# --- Misc --------------------------------------------------------------
# Public site origin — canonical URLs / sitemap / OG tags.
# On Vercel set this to your production domain, e.g. https://sarnsarene.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payment provider: "mock" (default) | "omise" | …
PAYMENT_PROVIDER="mock"
# Only needed when PAYMENT_PROVIDER is a real gateway:
# PAYMENT_SECRET_KEY=""
# PAYMENT_PUBLIC_KEY=""
